{
  "project": "BusinessIntelligence.ai KPI Engine",
  "version": "1.0.0",
  "semantic_layer": {
    "kpis": {
      "Revenue": {
        "description": "Total sales revenue derived from units sold * average selling price.",
        "calculation_type": "additive",
        "sql_formula": "SUM(revenue)",
        "source_table": "fact_sales_daily",
        "dimensions": ["state_id", "cat_id", "dept_id", "item_id", "date"],
        "granularity": "daily"
      },
      "GrossMarginPercent": {
        "description": "Gross profit margin percentage representing profit relative to revenue.",
        "calculation_type": "non_additive",
        "sql_formula": "(SUM(revenue) - SUM(cost_of_goods_sold)) / SUM(revenue)",
        "source_table": "fact_sales_daily",
        "dimensions": ["state_id", "cat_id", "dept_id", "item_id", "date"],
        "granularity": "daily"
      },
      "InventoryTurnover": {
        "description": "Indicates the supply chain efficiency in moving products, computed as monthly COGS / average inventory value.",
        "calculation_type": "non_additive",
        "sql_formula": "SUM(cost_of_goods_sold) / AVG(inventory_on_hand * supplier_raw_cost)",
        "source_table": "inventory_logs",
        "dimensions": ["warehouse_name", "state_id", "date"],
        "granularity": "daily"
      }
    },
    "mappings": {
      "region_to_state": {
        "West": "CA",
        "South": "TX"
      },
      "state_to_region": {
        "CA": "West",
        "TX": "South"
      }
    },
    "entitlements": {
      "vp_sales": {
        "role_name": "VP of Retail Sales (Executive)",
        "allowed_columns": [
          "fact_sales_daily.date",
          "fact_sales_daily.state_id",
          "fact_sales_daily.cat_id",
          "fact_sales_daily.dept_id",
          "fact_sales_daily.units",
          "fact_sales_daily.sell_price",
          "fact_sales_daily.revenue",
          "fact_sales_daily.cost_of_goods_sold",
          "fact_sales_daily.gross_margin_percent",
          "source_marketing_weekly.week_start_monday",
          "source_marketing_weekly.region_name",
          "source_marketing_weekly.channel",
          "source_marketing_weekly.marketing_spend"
        ],
        "restricted_columns": [
          "sku_lookup.warehouse_sku",
          "sku_lookup.supplier_raw_cost",
          "source_supply_monthly.warehouse_sku",
          "source_supply_monthly.fill_rate",
          "source_supply_monthly.stockout_days"
        ],
        "masking_actions": {
          "sku_lookup.warehouse_sku": "MASK_RESTRICTED",
          "sku_lookup.supplier_raw_cost": "MASK_NULL",
          "source_supply_monthly.warehouse_sku": "MASK_RESTRICTED",
          "source_supply_monthly.fill_rate": "MASK_NULL",
          "source_supply_monthly.stockout_days": "MASK_NULL"
        }
      },
      "supply_planner": {
        "role_name": "Regional Supply Chain Planner (Analyst)",
        "allowed_columns": [
          "fact_sales_daily.date",
          "fact_sales_daily.state_id",
          "fact_sales_daily.cat_id",
          "fact_sales_daily.dept_id",
          "fact_sales_daily.units",
          "fact_sales_daily.sell_price",
          "sku_lookup.item_id",
          "sku_lookup.warehouse_sku",
          "source_supply_monthly.warehouse_sku",
          "source_supply_monthly.state_id",
          "source_supply_monthly.month",
          "source_supply_monthly.fill_rate",
          "source_supply_monthly.stockout_days"
        ],
        "restricted_columns": [
          "fact_sales_daily.revenue",
          "fact_sales_daily.cost_of_goods_sold",
          "fact_sales_daily.gross_margin_percent",
          "sku_lookup.supplier_raw_cost",
          "source_marketing_weekly.marketing_spend"
        ],
        "masking_actions": {
          "fact_sales_daily.revenue": "MASK_NULL",
          "fact_sales_daily.cost_of_goods_sold": "MASK_NULL",
          "fact_sales_daily.gross_margin_percent": "MASK_NULL",
          "sku_lookup.supplier_raw_cost": "MASK_NULL",
          "source_marketing_weekly.marketing_spend": "MASK_NULL"
        }
      }
    }
  }
}
